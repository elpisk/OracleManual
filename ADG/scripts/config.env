# ============================================================================
#  Active Data Guard 구축 공통 설정
#  비밀번호는 여기에 적지 않는다 — 아래 "비밀번호" 절 참고.
# ============================================================================

# ── 노드 ────────────────────────────────────────────────────────────────────
PRI_HOST=chicago-srv
STB_HOST=boston-srv
PRI_IP=172.16.225.60
STB_IP=172.16.225.61
DOMAIN=localdomain

# ── 데이터베이스 ────────────────────────────────────────────────────────────
DB_NAME=chicago            # 양쪽이 같다 — physical standby 는 블록 단위 동일 복제본이다
PRI_UNIQUE=chicago         # DB_UNIQUE_NAME 은 달라야 한다
STB_UNIQUE=boston
PRI_SID=chicago
STB_SID=boston
PDB_NAME=chicago_pdb1

# ── 홈 · 경로 ───────────────────────────────────────────────────────────────
ORA_BASE=/u01/app/oracle
ORA_HOME=/u01/app/oracle/product/19.3.0/dbhome_1
PRI_DATA=/u03/app/oracle/oradata/Chicago
STB_DATA=/u03/app/oracle/oradata/Boston/datafile
STB_LOG=/u03/app/oracle/oradata/Boston/onlinelog
STB_CTL=/u03/app/oracle/oradata/Boston/controlfile
FRA=/u03/app/oracle/fast_recovery_area
FRA_SIZE=15g

# ── 리두 ────────────────────────────────────────────────────────────────────
# Standby Redo Log 는 온라인 리두 그룹 수 + 1 개를 같은 크기로 만든다.
SRL_START_GROUP=4
SRL_COUNT=4
SRL_SIZE=200m

# ── 전송 모드 ───────────────────────────────────────────────────────────────
TRANSPORT_MODE=async       # async | sync
LISTENER_PORT=1521

# ── 비밀번호 ────────────────────────────────────────────────────────────────
# 스크립트는 아래 환경 변수에서 읽는다. 이 파일에 적지 않는다.
#   export ADG_SYS_PW=...    SYS (RMAN DUPLICATE 접속에 쓴다)
#   export ADG_OS_PW=...     oracle OS 계정 (run_all.py 의 SSH 접속용)
