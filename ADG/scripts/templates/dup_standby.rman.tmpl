# RMAN DUPLICATE — 실행 중인 Primary 에서 Standby 를 직접 만든다(FROM ACTIVE DATABASE).
# 백업본이 없어도 되고, DORECOVER 로 복제 직후 시점까지 복구까지 마친다.
run
{
  allocate channel c1 type disk;
  allocate channel c2 type disk;
  allocate auxiliary channel sby type disk;

  duplicate target database for standby from active database
  DORECOVER
  spfile
    parameter_value_convert '@PRI_UNIQUE@','@STB_UNIQUE@'
    set db_name           = '@DB_NAME@'
    set db_unique_name    = '@STB_UNIQUE@'
    set audit_file_dest   = '@ORA_BASE@/admin/@STB_UNIQUE@/adump'
    set diagnostic_dest   = '@ORA_BASE@/'
    set db_file_name_convert  = '@PRI_DATA@/', '@STB_DATA@/'
    set log_file_name_convert = '@PRI_DATA@/', '@STB_LOG@/'
    set control_files     = '@STB_CTL@/control_standby01.ctl'
    set log_archive_dest_2 =
      'service=@PRI_UNIQUE@ @MODE@ valid_for=(online_logfile,primary_role) db_unique_name=@PRI_UNIQUE@'
    set log_archive_max_processes = '4'
    set fal_server              = '@PRI_UNIQUE@'
    set standby_file_management  = 'AUTO'
    set log_archive_config       = 'dg_config=(@PRI_UNIQUE@,@STB_UNIQUE@)'
    nofilenamecheck;

  sql channel sby
    "alter database recover managed standby database disconnect from session";
}
