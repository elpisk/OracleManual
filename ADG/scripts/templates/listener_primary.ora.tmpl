# Primary 리스너 — 정적 등록이 필요하다.
# RMAN DUPLICATE 는 Standby 가 NOMOUNT 인 상태에서 접속하는데,
# 동적 등록은 인스턴스가 열려야 이루어지므로 정적 항목이 없으면 붙지 못한다.
LISTENER =
  (DESCRIPTION_LIST =
    (DESCRIPTION =
      (ADDRESS = (PROTOCOL = TCP)(HOST = @PRI_HOST@)(PORT = @PORT@))
    )
  )

SID_LIST_LISTENER =
  (SID_LIST =
    (SID_DESC =
      (GLOBAL_DBNAME = @PRI_UNIQUE@)
      (ORACLE_HOME = @ORA_HOME@)
      (SID_NAME = @PRI_SID@)
    )
    (SID_DESC =
      (GLOBAL_DBNAME = @PRI_UNIQUE@_DGMGRL)
      (ORACLE_HOME = @ORA_HOME@)
      (SID_NAME = @PRI_SID@)
    )
  )

ADR_BASE_LISTENER = @ORA_BASE@
