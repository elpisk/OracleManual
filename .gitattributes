# 리눅스에서 실행되는 파일은 반드시 LF 로 체크아웃한다.
# CRLF 로 내려가면 bash 가 $'\r': command not found 로 죽는다.
*.sh            text eol=lf
*.tmpl          text eol=lf
config.env      text eol=lf
*.rman          text eol=lf
*.sql           text eol=lf

# Windows 전용
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# 바이너리 — 변환하지 않는다
*.docx          binary
*.pptx          binary
*.xlsx          binary
*.pdf           binary
*.png           binary
*.jpg           binary
*.zip           binary
*.vmdk          binary
