# 리눅스에서 실행되는 파일은 반드시 LF 로 체크아웃한다.
# CRLF 로 내려가면 bash 가 $'\r': command not found 로 죽는다.
*.sh            text eol=lf
*.tmpl          text eol=lf
config.env      text eol=lf
*.rman          text eol=lf
*.sql           text eol=lf

# Windows 전용
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# 바이너리 — 변환하지 않는다
*.docx          binary
*.pptx          binary
*.xlsx          binary
*.pdf           binary
*.png           binary
*.jpg           binary
*.zip           binary
*.vmdk          binary

# LOB 실습 파일 — 크기(바이트 수) 자체가 실습 내용이므로 줄바꿈 변환을 금지한다
# manual.txt 가 CRLF 로 내려가면 7,566 -> 7,668 바이트가 되어 실습 03 의 설명과 어긋난다
LOB/lobfiles/manual.txt   -text
LOB/lobfiles/photo.bin    binary
LOB/lobfiles/big.dat      binary
