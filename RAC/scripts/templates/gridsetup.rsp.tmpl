####################################################################
## Oracle Grid Infrastructure 19c — 2노드 RAC 무인 설치 응답 파일
## 20_gi_install.sh 가 @변수@ 를 config.env 값으로 치환해 생성한다.
## 비밀번호는 환경 변수 RAC_ASM_PW 에서 읽는다.
####################################################################
oracle.install.responseFileVersion=/oracle/install/rspfmt_crsinstall_response_schema_v19.0.0
INVENTORY_LOCATION=@INVENTORY@
oracle.install.option=CRS_CONFIG
ORACLE_BASE=@GRID_BASE@

oracle.install.asm.OSDBA=asmdba
oracle.install.asm.OSOPER=asmoper
oracle.install.asm.OSASM=asmadmin

oracle.install.crs.config.scanType=LOCAL_SCAN
oracle.install.crs.config.gpnp.scanName=@SCAN_NAME@
oracle.install.crs.config.gpnp.scanPort=@SCAN_PORT@

oracle.install.crs.config.ClusterConfiguration=STANDALONE
oracle.install.crs.config.configureAsExtendedCluster=false
oracle.install.crs.config.clusterName=@CLUSTER_NAME@
oracle.install.crs.config.gpnp.configureGNS=false
oracle.install.crs.config.autoConfigureClusterNodeVIP=false

## 노드 목록 — hostname:vip:role
oracle.install.crs.config.clusterNodes=@NODE1_NAME@:@NODE1_NAME@-vip:HUB,@NODE2_NAME@:@NODE2_NAME@-vip:HUB

## 인터페이스 — 이름:서브넷:용도 (1=public, 5=ASM+private)
## 인터페이스 이름은 20_gi_install.sh 가 실제 값으로 채운다.
oracle.install.crs.config.networkInterfaceList=@PUBIF@:@PUB_SUBNET@:1,@PRVIF@:@PRIV_SUBNET@:5

## GIMR 은 별도 디스크그룹과 수 GB 를 더 요구한다. 실습에서는 쓰지 않는다.
oracle.install.crs.configureGIMR=false
oracle.install.asm.configureGIMRDataDG=false

oracle.install.crs.config.storageOption=FLEX_ASM_STORAGE
oracle.install.crs.config.useIPMI=false

## ASM — CRS 디스크그룹
oracle.install.asm.SYSASMPassword=@ASM_PW@
oracle.install.asm.monitorPassword=@ASM_PW@
oracle.install.asm.diskGroup.name=@DG_CRS@
oracle.install.asm.diskGroup.redundancy=@DG_CRS_REDUNDANCY@
oracle.install.asm.diskGroup.AUSize=@ASM_AU_SIZE@
oracle.install.asm.diskGroup.disks=@CRS_DISKS_PLAIN@
oracle.install.asm.diskGroup.disksWithFailureGroupNames=@CRS_DISKS_FG@
oracle.install.asm.diskGroup.diskDiscoveryString=@ASM_DISCOVERY@
oracle.install.asm.configureAFD=false

oracle.install.crs.configureRHPS=false
oracle.install.crs.config.ignoreDownNodes=false
oracle.install.config.managementOption=NONE
oracle.install.config.omsPort=0

## root.sh 를 설치 관리자가 자동 실행하지 않게 한다.
## 노드 순서를 직접 통제해야 하기 때문이다(21_root_sh.sh).
oracle.install.crs.rootconfig.executeRootScript=false
