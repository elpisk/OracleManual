# ============================================================================
#  RAC 구축 공통 설정 — 모든 스크립트가 이 파일을 읽는다.
#  값을 바꾸려면 여기만 고친다.
#  비밀번호는 여기에 적지 않는다. 아래 "비밀번호" 절 참고.
# ============================================================================

# ── 노드 ────────────────────────────────────────────────────────────────────
NODE1_NAME=rac1
NODE2_NAME=rac2
NODE1_PUB=172.16.225.101
NODE2_PUB=172.16.225.102
NODE1_VIP=172.16.225.111
NODE2_VIP=172.16.225.112
NODE1_PRIV=172.16.119.101
NODE2_PRIV=172.16.119.102

PUB_SUBNET=172.16.225.0
PRIV_SUBNET=172.16.119.0
PUB_PREFIX=24
PUB_GATEWAY=172.16.225.2
DOMAIN=localdomain

# ── SCAN / 클러스터 ─────────────────────────────────────────────────────────
SCAN_NAME=rac-scan
SCAN_IP=172.16.225.120
SCAN_PORT=1521
CLUSTER_NAME=rac-cluster

# ── 홈 경로 ─────────────────────────────────────────────────────────────────
GRID_BASE=/u01/app/grid
GRID_HOME=/u01/app/19.3.0/grid
ORA_BASE=/u01/app/oracle
ORA_HOME=/u01/app/oracle/product/19.3.0/dbhome_rac
INVENTORY=/u01/app/oraInventory
INST_GROUP=oinstall

# ── 설치 미디어 (노드에서 보이는 경로) ──────────────────────────────────────
GRID_ZIP=/mnt/hgfs/sh/19c_grid_linux.zip
DB_ZIP=/mnt/hgfs/sh/19c_db_linux.zip

# ── ASM ─────────────────────────────────────────────────────────────────────
ASM_DISCOVERY=/dev/asmdisk/*
DG_CRS=CRS
DG_CRS_REDUNDANCY=NORMAL
DG_CRS_DISKS='/dev/asmdisk/crs1','/dev/asmdisk/crs2','/dev/asmdisk/crs3'
DG_DATA=DATA
DG_DATA_DISKS='/dev/asmdisk/data1','/dev/asmdisk/data2','/dev/asmdisk/data3'
DG_FRA=FRA
DG_FRA_DISKS='/dev/asmdisk/fra1','/dev/asmdisk/fra2'
ASM_COMPATIBLE=19.0.0.0
ASM_AU_SIZE=4

# udev 규칙이 크기로 용도를 가른다 (GB)
DISK_GB_CRS=4
DISK_GB_DATA=20
DISK_GB_FRA=12

# ── 데이터베이스 ────────────────────────────────────────────────────────────
DB_NAME=racdb
DB_SID_PREFIX=racdb
PDB_NAME=racpdb1
DB_MEMORY_MB=2400
REDO_MB=200
DB_CHARSET=AL32UTF8

# ── OS 그룹 (GID 고정 — 두 노드에서 같아야 한다) ────────────────────────────
GROUPS_SPEC="54321 oinstall|54322 dba|54323 oper|54324 backupdba|54325 dgdba|54326 kmdba|54327 asmdba|54328 asmoper|54329 asmadmin|54330 racdba"

# ── 비밀번호 ────────────────────────────────────────────────────────────────
# 스크립트는 아래 환경 변수에서 읽는다. 이 파일에 적지 않는다.
#   export RAC_ASM_PW=...     SYSASM / ASMSNMP
#   export RAC_SYS_PW=...     SYS / SYSTEM / PDBADMIN
#   export RAC_OS_PW=...      root, grid, oracle OS 계정 (run_all.py 의 SSH 접속용)
# 설정하지 않으면 스크립트가 실행을 거부한다.
