# =============================================================================
#  rc_global_scripts.rman  —  조직 표준 글로벌 Stored Script 정의
#  출처   : 고급 실습 03
#  실행   : rman catalog rcatowner@rcat @rc_global_scripts.rman
#
#  치환 변수
#    &1 = 태그 접두어 (보통 DB 이름 대문자)
#
#  주의
#    - 이 파일은 CREATE 명령을 담고 있다. 스크립트 본문은 scripts/ 아래 별도 파일이다.
#    - 대화형으로 CREATE 하면 치환 변수 값을 물어볼 수 있으므로 FROM FILE 을 쓴다.
#    - 이미 존재하면 CREATE 는 실패한다. 갱신은 REPLACE 를 쓴다.
#    - 카탈로그는 변경 이력을 남기지 않는다. 원본 파일을 형상 관리 도구에 둔다.
# =============================================================================

# ---- 최초 등록 ----
CREATE GLOBAL SCRIPT gs_daily_incr
  COMMENT '표준 일일 증분 백업 (&1 = 태그 접두어)'
  FROM FILE '/home/oracle/rcadm/scripts/gs_daily_incr.rman';

CREATE GLOBAL SCRIPT gs_weekly_full
  COMMENT '표준 주간 Level 0 백업 (&1 = 태그 접두어)'
  FROM FILE '/home/oracle/rcadm/scripts/gs_weekly_full.rman';

CREATE GLOBAL SCRIPT gs_archive_only
  COMMENT '아카이브 로그만 백업 (&1 = 태그 접두어)'
  FROM FILE '/home/oracle/rcadm/scripts/gs_archive_only.rman';

CREATE GLOBAL SCRIPT gs_maint_obsolete
  COMMENT '정합성 점검과 보존 정책 적용 (파라미터 없음)'
  FROM FILE '/home/oracle/rcadm/scripts/gs_maint_obsolete.rman';

CREATE GLOBAL SCRIPT gs_validate_full
  COMMENT '복구 가능성 검증 (파라미터 없음)'
  FROM FILE '/home/oracle/rcadm/scripts/gs_validate_full.rman';

LIST GLOBAL SCRIPT NAMES;

EXIT

# =============================================================================
#  아래는 scripts/ 아래에 두는 본문 파일들이다. 참고용으로 함께 기록한다.
# =============================================================================
#
# ---- scripts/gs_daily_incr.rman ----
# {
#   BACKUP INCREMENTAL LEVEL 1
#     CHECK LOGICAL
#     DATABASE
#     TAG '&1_INCR'
#     MAXPIECESIZE 2G
#     PLUS ARCHIVELOG
#     TAG '&1_ARCH'
#     NOT BACKED UP 1 TIMES;
#   BACKUP CURRENT CONTROLFILE TAG '&1_CF';
#   DELETE NOPROMPT OBSOLETE;
# }
#
# ---- scripts/gs_weekly_full.rman ----
# {
#   BACKUP INCREMENTAL LEVEL 0
#     CHECK LOGICAL
#     DATABASE
#     TAG '&1_FULL'
#     PLUS ARCHIVELOG
#     TAG '&1_ARCH';
#   BACKUP CURRENT CONTROLFILE TAG '&1_CF';
#   DELETE NOPROMPT OBSOLETE;
# }
#
# ---- scripts/gs_archive_only.rman ----
# {
#   SQL 'ALTER SYSTEM ARCHIVE LOG CURRENT';
#   BACKUP ARCHIVELOG ALL TAG '&1_ARCH' NOT BACKED UP 1 TIMES;
# }
#
# ---- scripts/gs_maint_obsolete.rman ----
# {
#   CROSSCHECK BACKUP;
#   CROSSCHECK ARCHIVELOG ALL;
#   DELETE NOPROMPT EXPIRED BACKUP;
#   DELETE NOPROMPT EXPIRED ARCHIVELOG ALL;
#   DELETE NOPROMPT OBSOLETE;
#   REPORT NEED BACKUP;
# }
#   ※ 이 스크립트를 그대로 크론에 걸면 고급 실습 04 오류 ②의 사고를 막지 못한다.
#     rc_maint_crosscheck.sh 실행기를 통해 호출한다.
#
# ---- scripts/gs_validate_full.rman ----
# {
#   RESTORE DATABASE VALIDATE;
#   RESTORE ARCHIVELOG ALL VALIDATE;
#   BACKUP VALIDATE CHECK LOGICAL DATABASE ARCHIVELOG ALL;
# }
#
# =============================================================================
#  갱신할 때는 REPLACE 를 쓴다
# =============================================================================
# REPLACE GLOBAL SCRIPT gs_daily_incr
#   COMMENT '표준 일일 증분 백업 (변경 이력은 git 참조)'
#   FROM FILE '/home/oracle/rcadm/scripts/gs_daily_incr.rman';
#
# =============================================================================
#  표준 CONFIGURE (DB별로 1회 적용. 절차가 아니라 설정이므로 스크립트와 분리한다)
# =============================================================================
# CONFIGURE RETENTION POLICY TO RECOVERY WINDOW OF 21 DAYS;
# CONFIGURE CONTROLFILE AUTOBACKUP ON;
# CONFIGURE DEVICE TYPE DISK PARALLELISM 4 BACKUP TYPE TO BACKUPSET;
# CONFIGURE CHANNEL DEVICE TYPE DISK FORMAT '/backup/%d/%U' MAXPIECESIZE 2G;
# CONFIGURE BACKUP OPTIMIZATION ON;
# CONFIGURE ARCHIVELOG DELETION POLICY TO BACKED UP 1 TIMES TO DISK;
